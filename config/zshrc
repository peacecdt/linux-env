# linux-env: small, readable Zsh configuration; no plugin manager required.
[[ -o interactive ]] || return 0

export EDITOR=${EDITOR:-vim}
export VISUAL=${VISUAL:-$EDITOR}
export PAGER=${PAGER:-less}
typeset -U path
path=("$HOME/.local/bin" $path)

HISTFILE="$HOME/.zsh_history"
HISTSIZE=20000
SAVEHIST=20000
setopt append_history inc_append_history extended_history
setopt hist_ignore_dups hist_ignore_space hist_reduce_blanks hist_verify
setopt interactive_comments auto_cd complete_in_word
unsetopt beep

# Keep the normal Emacs bindings. Up/Down search history by typed prefix.
bindkey -e
bindkey '^[[A' history-beginning-search-backward
bindkey '^[[B' history-beginning-search-forward
bindkey '^[[H' beginning-of-line
bindkey '^[[F' end-of-line
bindkey '^[[3~' delete-char
bindkey '^R' history-incremental-search-backward

autoload -Uz compinit
# A completion dump is executable shell code. Only cache under an owned,
# non-writable-by-others directory, and check every ancestor and existing dump.
# Never use compinit -u or -C: insecure completion directories stay excluded.
_linux_env_secure_path() {
    emulate -L zsh
    local item=${1:a}
    local -A info
    zmodload zsh/stat 2>/dev/null || return 1
    while true; do
        [[ ! -L "$item" ]] || return 1
        zstat -H info -- "$item" 2>/dev/null || return 1
        (( (info[uid] == EUID || info[uid] == 0) && (info[mode] & 0022) == 0 )) || return 1
        [[ "$item" == / ]] && return 0
        item=${item:h}
    done
}
_linux_env_init_completion() {
    emulate -L zsh
    local cache_root=${XDG_CACHE_HOME:-$HOME/.cache}
    [[ "$cache_root" == /* ]] || cache_root="$HOME/.cache"
    local cache="$cache_root/linux-env/zsh"
    local dump="$cache/zcompdump-$ZSH_VERSION"
    local saved_umask
    if (umask 077; command mkdir -p -- "$cache") 2>/dev/null &&
        [[ -O "$cache" && -w "$cache" ]] &&
        _linux_env_secure_path "$cache" &&
        { [[ ! -e "$dump" && ! -L "$dump" ]] ||
          { [[ -f "$dump" ]] && _linux_env_secure_path "$dump"; }; }; then
        saved_umask=$(umask)
        umask 077
        compinit -i -d "$dump"
        umask "$saved_umask"
    else
        compinit -i -D
    fi
}
_linux_env_init_completion
unfunction _linux_env_secure_path _linux_env_init_completion
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"

alias ll='ls -alF --color=auto'
alias la='ls -A --color=auto'
alias ..='cd ..'

# Learning convenience: keep libm after source/object files for link ordering.
# A shell function leaves the system compiler and build tools unchanged.
gcc() {
    emulate -L zsh
    local argument has_input=0
    if [[ ${LINUX_ENV_GCC_AUTO_MATH:-1} == 0 ]] || (( $# == 0 )) ||
        { (( $# == 1 )) && [[ $1 == -v ]]; }; then
        command gcc "$@"
        return $?
    fi
    for argument in "$@"; do
        case "$argument" in
            -c|--compile|-S|--assemble|-E|--preprocess|-M|-MM|-fsyntax-only|-r|\
            -nostdlib|--no-standard-libraries|-nodefaultlibs|-nolibc|-ffreestanding|\
            --version|--help|--help=*|--target-help|-dumpmachine|-dumpversion|-dumpfullversion|-dumpspecs|-print*)
                command gcc "$@"
                return $?
                ;;
            -|@*|-l?*|-Wl,*) has_input=1 ;;
            -*) ;;
            *) has_input=1 ;;
        esac
    done
    if (( has_input )); then
        command gcc "$@" -lm
    else
        command gcc "$@"
    fi
}

# A branch name is data. Escape prompt formatting and remove control characters.
# Detached HEADs display the short commit; no worktree scan on every prompt.
typeset -g _linux_env_git_prompt=''
_linux_env_update_prompt() {
    emulate -L zsh
    _linux_env_git_prompt=''
    (( $+commands[git] )) || return 0
    local branch
    branch=$(command git symbolic-ref --quiet --short HEAD 2>/dev/null) ||
        branch=$(command git rev-parse --short HEAD 2>/dev/null) || return 0
    branch=${branch//[[:cntrl:]]/?}
    branch=${branch//\%/%%}
    _linux_env_git_prompt=" %F{yellow}($branch)%f"
}
autoload -Uz add-zsh-hook
add-zsh-hook precmd _linux_env_update_prompt
setopt prompt_subst
PROMPT='%(!.%F{203}.%F{114})%n%f%F{245}@%f%F{110}%m%f:%F{180}%~%f${_linux_env_git_prompt} %(?.%F{114}.%F{203})%#%f '

if (( $+commands[rg] )); then
    export FZF_DEFAULT_COMMAND='rg --files --hidden --glob "!.git" --glob "!.venv" --glob "!build"'
    export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
fi
if (( $+commands[fzf] )); then
    # Ubuntu 22.04+ apt packages; tolerate either packaged layout.
    for _linux_env_fzf_dir in /usr/share/doc/fzf/examples /usr/share/fzf /usr/local/share/linux-env/fzf; do
        if [[ -r "$_linux_env_fzf_dir/key-bindings.zsh" ]]; then
            source "$_linux_env_fzf_dir/key-bindings.zsh"
            [[ -r "$_linux_env_fzf_dir/completion.zsh" ]] && source "$_linux_env_fzf_dir/completion.zsh"
            break
        fi
    done
    unset _linux_env_fzf_dir
fi

# Complete against the current command and filesystem on every edit. History
# suggestions can resurrect deleted filenames (or files from another directory).
# Keep history available through Up/Down and Ctrl+R, outside the gray suggestions.
ZSH_AUTOSUGGEST_STRATEGY=(linux_env_completion)
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=245'
[[ -r /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh ]] &&
    source /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh

_linux_env_file_command() {
    case "$1" in
        vim|vi|nvim|rm|gcc|g++|cc|c++|clang|clang++|cat|less|more|head|tail|wc|file|cp|mv|python|python3) return 0 ;;
        *) return 1 ;;
    esac
}

# Return just the suggested current word in REPLY, never additional arguments.
# Lexing/unquoting treats shell text as data; it does not evaluate substitutions.
_linux_env_current_word_suggestion() {
    emulate -L zsh
    local input=$1 proposed=$2 word raw file_path prefix command typed
    local -a input_words proposed_words
    REPLY=''
    [[ -n "$input" && -n "$proposed" ]] || return 1
    input_words=("${(@z)input}")
    proposed_words=("${(@z)proposed}")
    (( ${#input_words} && ${#proposed_words} >= ${#input_words} )) || return 1
    raw=${input_words[-1]}
    # Options are explicit: never suggest turning -i into -iA (or extend flags
    # of any other command). Tab completion remains available on demand.
    [[ "$raw" != -* ]] || return 1
    # An outside space starts a new argument. Do not invent one automatically.
    [[ "$input" == *"$raw" ]] || return 1
    command=${(Q)input_words[1]}
    word=${proposed_words[${#input_words}]}
    file_path=${(Q)word}
    typed=${(Q)raw}
    [[ "$file_path" == '~/'* ]] && file_path="$HOME/${file_path#\~/}"
    [[ "$typed" == '~/'* ]] && typed="$HOME/${typed#\~/}"
    if [[ "$command" == ./* || "$command" == ../* ]]; then
        (( ${#input_words} == 1 )) && [[ ! -f "$typed" && -f "$file_path" && -x "$file_path" ]] || return 1
    elif (( ${#input_words} > 1 )) && _linux_env_file_command "$command" && [[ "$raw" != -* ]]; then
        [[ ! -f "$typed" && ( -e "$file_path" || -L "$file_path" ) ]] || return 1
    fi
    prefix=${input:0:${#input}-${#raw}}
    REPLY="$prefix$word"
    [[ "$REPLY" == "$input"* && "$REPLY" != "$input" ]]
}

# Suggest a filename only while it is incomplete. In particular, a complete
# local executable must not acquire an unsolicited filename argument.
_zsh_autosuggest_strategy_linux_env_completion() {
    emulate -L zsh
    typeset -g suggestion=''
    local first=${1%%[[:space:]]*}
    local last=${1##*[[:space:]]}
    local candidate REPLY
    if [[ "$first" == ./* || "$first" == ../* ]] && [[ -f "$first" && -x "$first" ]]; then
        return 0
    fi
    [[ "$last" == -* || ( -n "$last" && -f "$last" ) ]] && return 0
    # Command-position completion differs from argument completion across Zsh
    # versions. For simple relative programs, use live executable files directly.
    if [[ "$1" == ./* || "$1" == ../* ]] && _linux_env_simple_path "$1"; then
        for candidate in "$1"*(N-.); do
            if [[ -x "$candidate" ]]; then
                suggestion=$candidate
                return 0
            fi
        done
    fi
    _zsh_autosuggest_strategy_completion "$1"
    if _linux_env_current_word_suggestion "$1" "$suggestion"; then
        suggestion=$REPLY
    else
        suggestion=''
    fi
}

# The plugin can reuse a suffix while typing, bypassing the strategy entirely.
# Validate cached/async suggestions immediately before every visible redraw too.
_linux_env_filter_suggestion() {
    emulate -L zsh
    local REPLY
    [[ -n "$POSTDISPLAY" ]] || return 0
    if _linux_env_current_word_suggestion "$BUFFER" "${BUFFER}${POSTDISPLAY}"; then
        POSTDISPLAY=${REPLY#$BUFFER}
    else
        POSTDISPLAY=''
    fi
}
autoload -Uz add-zle-hook-widget
add-zle-hook-widget line-pre-redraw _linux_env_filter_suggestion

# Enter accepts a simple Vim filename or a displayed relative executable path.
# Common file commands also accept just their displayed, existing filename.
# It never adds further arguments, pipelines, or an entire suggested command.
_linux_env_simple_path() {
    [[ -n "$1" && "$1" != *[^[:alnum:]_./~+-]* && "$1" != -* ]]
}
_linux_env_finish_line() {
    # Our custom Enter widget is excluded from the plugin's automatic wrappers.
    # Remove any unaccepted gray text and repaint before committing the line.
    POSTDISPLAY=''
    zle -R
    zle .accept-line
}
_linux_env_accept_line() {
    emulate -L zsh
    local prefix candidate typed word REPLY
    local -a matches words
    if [[ "$BUFFER" == 'vim '* ]]; then
        typed=${BUFFER#vim }
        if _linux_env_simple_path "$typed"; then
            prefix=$typed
            [[ "$prefix" == '~/'* ]] && prefix="$HOME/${prefix#\~/}"
            if [[ ! -e "$prefix" ]]; then
                candidate="${typed}${POSTDISPLAY}"
                # Completion can append a separating space after a full name.
                candidate=${candidate% }
                if _linux_env_simple_path "$candidate"; then
                    [[ "$candidate" == '~/'* ]] && candidate="$HOME/${candidate#\~/}"
                    if [[ "$candidate" == "$prefix"* && -f "$candidate" ]]; then
                        BUFFER="vim ${(q)candidate}"
                        POSTDISPLAY=''
                        _linux_env_finish_line
                        return
                    fi
                fi
                matches=("$prefix"*(N-.))
                if (( ${#matches} == 1 )); then
                    BUFFER="vim ${(q)matches[1]}"
                    POSTDISPLAY=''
                elif (( ${#matches} > 1 )); then
                    zle expand-or-complete
                    return
                fi
            fi
        fi
    elif [[ "$BUFFER" == ./* || "$BUFFER" == ../* ]]; then
        typed=$BUFFER
        candidate="${BUFFER}${POSTDISPLAY}"
        candidate=${candidate% }
        if _linux_env_simple_path "$typed" && _linux_env_simple_path "$candidate" &&
            [[ -n "$POSTDISPLAY" && ! -e "$typed" && "$candidate" == "$typed"* && -f "$candidate" && -x "$candidate" ]]; then
            BUFFER=${(q)candidate}
            POSTDISPLAY=''
        fi
    elif [[ -n "$POSTDISPLAY" ]]; then
        words=("${(@z)BUFFER}")
        if (( ${#words} > 1 )) && [[ "${words[-1]}" != -* ]] && _linux_env_file_command "${words[1]}"; then
            # Restrict Enter expansion to simple literal command lines. Quoted
            # paths and shell expressions retain normal Enter and Tab behavior.
            for word in "${words[@]}"; do
                if [[ -z "$word" || "$word" == *[^[:alnum:]_./~+=-]* ]]; then
                    _linux_env_finish_line
                    return
                fi
            done
            if _linux_env_current_word_suggestion "$BUFFER" "${BUFFER}${POSTDISPLAY}"; then
                BUFFER=$REPLY
                POSTDISPLAY=''
            fi
        fi
    fi
    _linux_env_finish_line
}
zle -N _linux_env_accept_line
bindkey '^M' _linux_env_accept_line
bindkey '^J' _linux_env_accept_line
bindkey '^I' expand-or-complete

# Put personal aliases and settings here; installers do not replace this file.
[[ -r "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"

# Syntax highlighting should be loaded after widgets and personal bindings.
if [[ -r /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]]; then
    source /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
fi
