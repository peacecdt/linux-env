" linux-env: native Vim, usable offline, without a network plugin manager.
set nocompatible
set encoding=utf-8
set nomodeline
set noexrc
" Keep archived ~/.vim plugins out of this profile without deleting them.
" Opt-in personal runtime files belong under ~/.config/linux-env/vim instead.
let s:personal_runtime = expand('~/.config/linux-env/vim')
" Load only this apt-managed diagnostic plugin, keeping old ~/.vim isolated.
let s:diagnostic_runtime = filereadable('/usr/share/vim-ale/plugin/ale.vim') ? '/usr/share/vim-ale,' : ''
let &runtimepath = escape(s:personal_runtime, ',') . ','
            \ . s:diagnostic_runtime
            \ . escape($VIMRUNTIME, ',') . ','
            \ . escape(s:personal_runtime . '/after', ',')
let &packpath = &runtimepath
filetype plugin indent on
syntax enable

set number
set cursorline
set cursorcolumn
" Underline the cursor row and shade its column, keeping syntax colors. Reapply
" when a personal colorscheme or a light/dark background is selected later.
function! s:CursorGuides() abort
    highlight CursorLine term=underline cterm=underline ctermbg=NONE ctermfg=NONE gui=underline guibg=NONE guifg=NONE
    if &background ==# 'dark'
        highlight CursorColumn cterm=NONE ctermbg=237 ctermfg=NONE gui=NONE guibg=#303744 guifg=NONE
    else
        highlight CursorColumn cterm=NONE ctermbg=252 ctermfg=NONE gui=NONE guibg=#dce2eb guifg=NONE
    endif
endfunction
call s:CursorGuides()
augroup linux_env_cursor_guides
    autocmd!
    autocmd ColorScheme * call <SID>CursorGuides()
    autocmd OptionSet background call <SID>CursorGuides()
augroup END
set ruler
set showcmd
set laststatus=2
set signcolumn=yes
set hidden
set mouse=a
set backspace=indent,eol,start
set expandtab
set tabstop=4
set softtabstop=4
set shiftwidth=4
set autoindent
set smartcase
set ignorecase
set incsearch
set hlsearch
set wildmenu
set wildmode=longest:full,full
set wildignore+=*/.git/*,*/.venv/*,*/build/*,*.o,*.pyc
set splitright
set splitbelow
set scrolloff=5
set updatetime=300
set showmode
set statusline=%f\ %h%m%r%=%{&filetype}\ %l:%c\ %p%%
" Use normal project tags, searching upward; do not index /usr/include at startup.
set tags=./tags;,tags
set path=.,include,src,/usr/local/include,/usr/include

let mapleader = ' '
nnoremap <leader>w :write<CR>
nnoremap <leader>b :make<CR>
nnoremap <leader>q :copen<CR>
nnoremap <leader>e :Lexplore<CR>
nnoremap <leader>n :nohlsearch<CR>
nnoremap ]q :cnext<CR>
nnoremap [q :cprevious<CR>

let g:netrw_banner = 0
let g:netrw_liststyle = 3
let g:netrw_winsize = 25

" Background diagnostics: installed by apt, with no plugin manager or LSP setup.
" Check completed lines; retain confirmed problems until a fresh check fixes them.
let g:ale_linters_explicit = 1
let g:ale_linters = {'c': ['cc'], 'cpp': ['cc'], 'python': ['flake8']}
let g:ale_c_cc_executable = 'clang'
let g:ale_cpp_cc_executable = 'clang++'
let g:ale_c_cc_options = '-std=c17 -Wall -Wextra'
let g:ale_cpp_cc_options = '-std=c++17 -Wall -Wextra'
let g:ale_c_parse_compile_commands = 1
let g:ale_c_parse_makefile = 0
let g:ale_python_flake8_use_global = 1
let g:ale_python_flake8_options = '--select=E9,F63,F7,F82'
let g:ale_lint_on_enter = 1
let g:ale_lint_on_save = 1
let g:ale_lint_on_insert_leave = 1
let g:ale_lint_on_text_changed = 'never'
let g:ale_lint_on_filetype_changed = 0
let g:ale_sign_error = '>>'
let g:ale_sign_warning = '!!'
let g:ale_set_signs = 1
let g:ale_set_highlights = 1
let g:ale_echo_cursor = 1
let g:ale_echo_delay = 200
let g:ale_virtualtext_cursor = 0
let g:ale_set_loclist = 1
let g:ale_set_quickfix = 0
" Refresh lists before returning, so an older deferred update cannot restore
" diagnostics which the edit handlers below have just hidden or cleared.
let g:ale_set_lists_synchronously = 1
let g:ale_open_list = 0
let g:ale_fix_on_save = 0
let g:ale_completion_enabled = 0
nnoremap <silent> ]d :ALENextWrap<CR>
nnoremap <silent> [d :ALEPreviousWrap<CR>

function! s:DiagnosticsEnabled() abort
    return &buftype ==# '' && exists(':ALELint') == 2
                \ && get(g:, 'ale_enabled', 1) && get(b:, 'ale_enabled', 1)
endfunction

let s:diagnostic_showmode_restore = -1
function! s:ClearDiagnosticEcho() abort
    let l:info = get(get(g:, 'ale_buffer_info', {}), bufnr(''), {})
    if get(l:info, 'echoed', 0)
        echo ''
        let l:info.echoed = 0
    endif
    if s:diagnostic_showmode_restore != -1
        let &showmode = s:diagnostic_showmode_restore
        let s:diagnostic_showmode_restore = -1
    endif
endfunction

let s:insert_diagnostic_echo_timer = -1
function! s:StopInsertDiagnosticEcho() abort
    if s:insert_diagnostic_echo_timer != -1
        call timer_stop(s:insert_diagnostic_echo_timer)
        let s:insert_diagnostic_echo_timer = -1
    endif
endfunction

function! s:EchoInsertDiagnostic(buffer, row, tick, timer) abort
    if a:timer != s:insert_diagnostic_echo_timer
        return
    endif
    let s:insert_diagnostic_echo_timer = -1
    if bufnr('') != a:buffer || line('.') != a:row || b:changedtick != a:tick
                \ || !s:DiagnosticsEnabled() || mode(1) !~# '^i'
                \ || get(b:, 'linux_env_diagnostic_pending_row', 0) == a:row
        return
    endif
    let [l:info, l:item] = ale#util#FindItemAtCursor(a:buffer)
    if empty(l:item)
        call s:ClearDiagnosticEcho()
        return
    endif
    let l:text = ale#GetLocItemMessage(l:item, ale#Var(a:buffer, 'echo_msg_format'))
    let l:text = strtrans(substitute(l:text, '[\r\n\t]', ' ', 'g'))
    " ALE's normal-mode echo helper uses :normal, which would interrupt INSERT.
    " Keep this to one display row, including wide characters, without a prompt.
    let l:width = max([0, v:echospace - 1])
    if l:width == 0
        return
    endif
    if strdisplaywidth(l:text) > l:width
        let l:text = strcharpart(l:text, 0, l:width)
        let l:suffix = l:width >= 4 ? '...' : ''
        while strdisplaywidth(l:text . l:suffix) > l:width
            let l:text = strcharpart(l:text, 0, strchars(l:text) - 1)
        endwhile
        let l:text .= l:suffix
    endif
    " Vim otherwise repaints -- INSERT -- over a timer's message immediately.
    " Restore the user's mode display as soon as this diagnostic is cleared.
    if s:diagnostic_showmode_restore == -1
        let s:diagnostic_showmode_restore = &showmode
    endif
    set noshowmode
    redraw
    unsilent echo l:text
    let l:info.echoed = 1
endfunction

function! s:QueueInsertDiagnosticEcho() abort
    if get(g:, 'ale_echo_cursor', 1)
        let s:insert_diagnostic_echo_timer = timer_start(max([0, g:ale_echo_delay]),
                    \ function('s:EchoInsertDiagnostic', [bufnr(''), line('.'), b:changedtick]))
    endif
endfunction

function! s:DiagnosticCheckStarted() abort
    " ALE exposes the requested buffer here, even for background buffers.
    let l:buffer = get(g:, 'ale_want_results_buffer', 0)
    if l:buffer > 0
        call setbufvar(l:buffer, 'linux_env_diagnostic_request_tick', getbufvar(l:buffer, 'changedtick'))
        call setbufvar(l:buffer, 'linux_env_diagnostic_request_kind',
                    \ getbufvar(l:buffer, 'linux_env_diagnostic_next_kind', 'full'))
        call setbufvar(l:buffer, 'linux_env_diagnostic_next_kind', 'full')
    endif
endfunction

function! s:DiagnosticAtRow(item, buffer, row) abort
    return get(a:item, 'bufnr', a:buffer) == a:buffer && a:item.lnum <= a:row
                \ && max([a:item.lnum, get(a:item, 'end_lnum', 0)]) >= a:row
endfunction

function! s:DisplayDiagnostics(buffer, items, follow_signs) abort
    let l:info = get(get(g:, 'ale_buffer_info', {}), a:buffer, {})
    if empty(l:info)
        return
    endif
    " Existing ALE sign IDs track Vim's line insertions/deletions. Follow them
    " before repainting, and move the end of a multiline highlight as well.
    let l:positions = map(copy(a:items), '[v:val, v:val.lnum]')
    if g:ale_set_signs
        call ale#sign#SetSigns(a:buffer, a:items)
        if a:follow_signs
            for [l:item, l:old_row] in l:positions
                if get(l:item, 'end_lnum', 0) > 0
                    let l:item.end_lnum = max([l:item.lnum, l:item.end_lnum + l:item.lnum - l:old_row])
                endif
            endfor
        endif
    endif
    " Keep ALE's cache, navigation, signs and list in agreement. Calling
    " engine#SetResults here would recursively emit another ALELintPost.
    let l:info.loclist = a:items
    if g:ale_set_highlights
        call ale#highlight#SetHighlights(a:buffer, a:items)
    endif
    if g:ale_set_loclist || g:ale_set_quickfix
        call ale#list#SetLists(a:buffer, a:items)
    endif
    if exists('*ale#statusline#Update')
        call ale#statusline#Update(a:buffer, a:items)
    endif
endfunction

function! s:RefreshInsertDiagnostics() abort
    call s:StopInsertDiagnosticEcho()
    if s:DiagnosticsEnabled() && mode(1) =~# '^i'
        call s:QueueInsertDiagnosticEcho()
    endif
endfunction

function! s:DiagnosticResults() abort
    " ALELintPost has no buffer argument in the oldest supported ALE. The lint
    " counter identifies completed buffers, including one checked in background.
    for l:key in keys(get(g:, 'ale_buffer_info', {}))
        let l:buffer = str2nr(l:key)
        let l:count = getbufvar(l:buffer, 'ale_linted', 0)
        if l:buffer <= 0 || l:count == getbufvar(l:buffer, 'linux_env_diagnostic_completed', 0)
            continue
        endif
        call setbufvar(l:buffer, 'linux_env_diagnostic_completed', l:count)
        let l:info = g:ale_buffer_info[l:key]
        let l:old = deepcopy(getbufvar(l:buffer, 'linux_env_diagnostic_confirmed', []))
        if getbufvar(l:buffer, 'linux_env_diagnostic_request_tick', -1) != getbufvar(l:buffer, 'changedtick')
            " A superseded worker must never restore an obsolete error or clear
            " an error using results from a different version of the buffer.
            call s:DisplayDiagnostics(l:buffer, l:old, 0)
            call setbufvar(l:buffer, 'linux_env_diagnostic_confirmed', deepcopy(l:old))
            continue
        endif
        let l:visible = deepcopy(l:info.loclist)
        let l:pending = getbufvar(l:buffer, 'linux_env_diagnostic_pending_row', 0)
        let l:kind = getbufvar(l:buffer, 'linux_env_diagnostic_request_kind', 'full')
        if l:buffer == bufnr('') && mode(1) =~# '^i' && l:pending > 0
            if l:kind ==# 'edit' && !empty(filter(copy(l:visible), 'v:val.type ==# "E"'))
                " Half-written new code can stop a compiler before it reaches
                " old errors. Keep confirmed results until leaving this row, or
                " until a successful check proves the buffer has no errors.
                let l:visible = l:old
            else
                call filter(l:visible, '!s:DiagnosticAtRow(v:val, l:buffer, l:pending)')
            endif
            call setbufvar(l:buffer, 'linux_env_diagnostic_hidden_row', 1)
        elseif l:buffer == bufnr('') && mode(1) =~# '^i' && l:kind ==# 'edit'
            let l:correction = get(b:, 'linux_env_diagnostic_correction_row', 0)
            if !empty(filter(copy(l:visible), 'v:val.type ==# "E" && s:DiagnosticAtRow(v:val, l:buffer, l:correction)'))
                " An unfinished repair can also stop parsing before other known
                " errors. Retain those until this repair or a full check finishes.
                for l:item in l:old
                    if l:item.type ==# 'E' && !s:DiagnosticAtRow(l:item, l:buffer, l:correction)
                                \ && empty(filter(copy(l:visible), 's:DiagnosticAtRow(v:val, l:buffer, l:item.lnum)'))
                        call add(l:visible, l:item)
                    endif
                endfor
                call sort(l:visible, 'ale#util#LocItemCompare')
            endif
        endif
        call s:DisplayDiagnostics(l:buffer, l:visible, 0)
        call setbufvar(l:buffer, 'linux_env_diagnostic_confirmed', deepcopy(l:visible))
    endfor
    if mode(1) =~# '^i'
        call s:ClearDiagnosticEcho()
        call s:RefreshInsertDiagnostics()
    endif
endfunction

function! s:StopDiagnosticCheck() abort
    let l:timer = get(b:, 'linux_env_diagnostic_timer', -1)
    if l:timer != -1
        call timer_stop(l:timer)
        let b:linux_env_diagnostic_timer = -1
    endif
endfunction

function! s:CheckEditedDiagnostics(buffer, tick, timer) abort
    if getbufvar(a:buffer, 'linux_env_diagnostic_timer', -1) != a:timer
        return
    endif
    call setbufvar(a:buffer, 'linux_env_diagnostic_timer', -1)
    if bufnr('') == a:buffer && b:changedtick == a:tick && s:DiagnosticsEnabled()
        let b:linux_env_diagnostic_next_kind = 'edit'
        call ale#Queue(0)
    endif
endfunction

function! s:DiagnosticEditEvent(check_line) abort
    if !s:DiagnosticsEnabled()
        return
    endif
    let l:tick = b:changedtick
    let l:row = line('.')
    let l:previous_row = get(b:, 'linux_env_diagnostic_row', l:row)
    let l:requested_tick = get(b:, 'linux_env_diagnostic_request_tick', -1)
    let l:changed = l:tick != get(b:, 'linux_env_diagnostic_edit_tick', l:tick)
    if l:row != l:previous_row
        let b:linux_env_diagnostic_pending_row = 0
        let b:linux_env_diagnostic_correction_row = 0
    endif
    if l:changed || l:row != l:previous_row
        call s:ClearDiagnosticEcho()
        call s:StopDiagnosticCheck()
    endif
    if l:changed && l:tick != l:requested_tick
        " Cancel obsolete workers WITHOUT clearing signs. A keystroke is not
        " evidence that an existing error was fixed.
        call ale#engine#Stop(bufnr(''))
        let l:confirmed = deepcopy(get(b:, 'linux_env_diagnostic_confirmed', []))
        call s:DisplayDiagnostics(bufnr(''), l:confirmed, 1)
        " ALE mutates its loclist in place as workers return. The confirmed
        " snapshot must not alias that live list, even after moving its signs.
        let b:linux_env_diagnostic_confirmed = deepcopy(l:confirmed)
        if !empty(filter(copy(l:confirmed), 's:DiagnosticAtRow(v:val, bufnr(""), l:row)'))
            let b:linux_env_diagnostic_correction_row = l:row
        endif
        let b:linux_env_diagnostic_pending_row = get(b:, 'linux_env_diagnostic_correction_row', 0) == l:row ? 0 : l:row
    endif
    let b:linux_env_diagnostic_edit_tick = l:tick
    let b:linux_env_diagnostic_row = l:row
    if a:check_line && l:row != l:previous_row && (l:tick != l:requested_tick
                \ || get(b:, 'linux_env_diagnostic_hidden_row', 0))
        let b:linux_env_diagnostic_hidden_row = 0
        let b:linux_env_diagnostic_next_kind = 'line'
        call ale#Queue(0)
    elseif l:changed && (!empty(get(b:, 'linux_env_diagnostic_confirmed', []))
                \ || get(b:, 'linux_env_diagnostic_correction_row', 0) > 0 || mode(1) !~# '^i')
        " While fixing a confirmed issue, check after a short typing pause even
        " on this same row. New, undiagnosed rows stay quiet until completed.
        let b:linux_env_diagnostic_timer = timer_start(400,
                    \ function('s:CheckEditedDiagnostics', [bufnr(''), l:tick]))
    endif
    call s:RefreshInsertDiagnostics()
endfunction

function! s:DiagnosticBufferEntered() abort
    let b:linux_env_diagnostic_row = line('.')
    let b:linux_env_diagnostic_edit_tick = b:changedtick
    let b:linux_env_diagnostic_pending_row = 0
    call s:RefreshInsertDiagnostics()
endfunction

function! s:DiagnosticInsertEnded() abort
    call s:StopDiagnosticCheck()
    call s:StopInsertDiagnosticEcho()
    call s:ClearDiagnosticEcho()
    let b:linux_env_diagnostic_pending_row = 0
    let b:linux_env_diagnostic_correction_row = 0
endfunction

augroup linux_env_diagnostics
    autocmd!
    autocmd BufEnter * call <SID>DiagnosticBufferEntered()
    autocmd InsertEnter * call <SID>DiagnosticEditEvent(0)
    autocmd InsertLeave,BufLeave * call <SID>DiagnosticInsertEnded()
    if exists('##ModeChanged')
        autocmd ModeChanged i*:n call <SID>DiagnosticInsertEnded()
    endif
    autocmd TextChanged,TextChangedI,CursorMoved,CursorMovedI * call <SID>DiagnosticEditEvent(1)
    if exists('##TextChangedP')
        autocmd TextChangedP * call <SID>DiagnosticEditEvent(1)
    endif
    autocmd User ALEWantResults call <SID>DiagnosticCheckStarted()
    autocmd User ALELintPost call <SID>DiagnosticResults()
augroup END

if executable('rg')
    set grepprg=rg\ --vimgrep\ --smart-case\ --
    set grepformat=%f:%l:%c:%m
endif

" Native insert-mode pairs for every filetype; no downloaded plugin required.
let g:linux_env_auto_pairs = get(g:, 'linux_env_auto_pairs', 1)
let s:pairs = {'(': ')', '[': ']', '{': '}', '"': '"', "'": "'", '`': '`'}
function! s:PairsEnabled() abort
    return g:linux_env_auto_pairs && !&paste && &buftype ==# ''
endfunction

function! s:PairEscaped() abort
    let l:before = strpart(getline('.'), 0, col('.') - 1)
    return strlen(matchstr(l:before, '\\\+$')) % 2
endfunction

function! s:PairInString() abort
    " Syntax highlighting may lag behind fast typing or macros. Scan the current
    " line as well, so a single quote inside a double-quoted string stays literal.
    let l:before = strpart(getline('.'), 0, col('.') - 1)
    let l:quote = ''
    let l:escaped = 0
    for l:char in split(l:before, '\zs')
        if l:escaped
            let l:escaped = 0
        elseif l:char ==# '\'
            let l:escaped = 1
        elseif empty(l:quote) && index(['"', "'", '`'], l:char) >= 0
            let l:quote = l:char
        elseif l:char ==# l:quote
            let l:quote = ''
        endif
    endfor
    if !empty(l:quote)
        return 1
    endif
    " Also recognize multiline strings when the filetype supplies syntax rules.
    return col('.') > 1 && l:before !~# '["''`]$'
                \ && synIDattr(synID(line('.'), col('.') - 1, 1), 'name') =~? 'string\|character'
endfunction

function! s:PairOpen(key) abort
    if !s:PairsEnabled() || s:PairEscaped()
        return a:key
    endif
    let l:before = strpart(getline('.'), 0, col('.') - 1)
    let l:next = strpart(getline('.'), col('.') - 1, 1)
    if index(['"', "'", '`'], a:key) >= 0
        if l:next ==# a:key
            return "\<Right>"
        endif
        " After two typed quotes, the third opens a Python triple-quoted string.
        if &filetype ==# 'python' && a:key !=# '`' && l:before =~# escape(repeat(a:key, 2), '\') . '$'
            return repeat(a:key, 4) . "\<Left>\<Left>\<Left>"
        endif
        " A quote within another string, or an apostrophe within a word, is literal.
        if s:PairInString() || (l:before =~# '\k$' && l:next =~# '\k')
            return a:key
        endif
    endif
    return a:key . s:pairs[a:key] . "\<Left>"
endfunction

function! s:PairClose(key) abort
    if s:PairsEnabled() && !s:PairEscaped() && strpart(getline('.'), col('.') - 1, 1) ==# a:key
        return "\<Right>"
    endif
    return a:key
endfunction

function! s:PairBackspace() abort
    let l:before = strpart(getline('.'), 0, col('.') - 1)
    let l:previous = strcharpart(l:before, strchars(l:before) - 1, 1)
    let l:next = strpart(getline('.'), col('.') - 1, 1)
    if s:PairsEnabled() && has_key(s:pairs, l:previous) && s:pairs[l:previous] ==# l:next
                \ && strlen(matchstr(strpart(l:before, 0, strlen(l:before) - 1), '\\\+$')) % 2 == 0
        return "\<BS>\<Del>"
    endif
    return "\<BS>"
endfunction

function! s:PairEnter() abort
    let l:previous = strpart(getline('.'), col('.') - 2, 1)
    let l:next = strpart(getline('.'), col('.') - 1, 1)
    if s:PairsEnabled() && !pumvisible() && !s:PairInString()
                \ && index(['(', '[', '{'], l:previous) >= 0 && s:pairs[l:previous] ==# l:next
        " Use the language's indentation rules; plain text gets one extra level.
        let l:indent = empty(&indentexpr) && !&cindent && !&smartindent ? "\<C-t>" : ''
        return "\<CR>\<C-o>O" . l:indent
    endif
    return "\<CR>"
endfunction

" Evaluate after pending text is inserted, including fast typing and macros.
inoremap <silent> ( <C-r>=<SID>PairOpen('(')<CR>
inoremap <silent> [ <C-r>=<SID>PairOpen('[')<CR>
inoremap <silent> { <C-r>=<SID>PairOpen('{')<CR>
inoremap <silent> " <C-r>=<SID>PairOpen('"')<CR>
inoremap <silent> ' <C-r>=<SID>PairOpen("'")<CR>
inoremap <silent> ` <C-r>=<SID>PairOpen('`')<CR>
inoremap <silent> ) <C-r>=<SID>PairClose(')')<CR>
inoremap <silent> ] <C-r>=<SID>PairClose(']')<CR>
inoremap <silent> } <C-r>=<SID>PairClose('}')<CR>
inoremap <silent> <BS> <C-r>=<SID>PairBackspace()<CR>
inoremap <silent><expr> <CR> <SID>PairEnter()

" Insert a header only for a new file. Existing files are never rewritten.
let g:linux_env_author = get(g:, 'linux_env_author', 'chendatao')
let g:linux_env_email = get(g:, 'linux_env_email', 'peacecdt@gmail.com')
function! s:NewSourceHeader() abort
    if line('$') != 1 || getline(1) !=# '' || &buftype !=# ''
        return
    endif
    let l:ext = tolower(expand('%:e'))
    let l:meta = ['File Name: ' . expand('%:t'),
                \ 'Author: ' . g:linux_env_author,
                \ 'Mail: ' . g:linux_env_email,
                \ 'Created Time: ' . strftime('%Y-%m-%d %H:%M:%S %Z')]
    if l:ext ==# 'py'
        let l:lines = ['#!/usr/bin/env python3', '# -*- coding: utf-8 -*-', '# ' . repeat('*', 70)]
        call extend(l:lines, map(copy(l:meta), '''# > '' . v:val'))
        call extend(l:lines, ['# ' . repeat('*', 70), '', 'import sys', 'from pathlib import Path', ''])
    else
        let l:lines = ['/' . repeat('*', 71)]
        call extend(l:lines, map(copy(l:meta), ''' * > '' . v:val'))
        call extend(l:lines, [' ' . repeat('*', 70) . '/', ''])
        if l:ext ==# 'c'
            call extend(l:lines, ['#include <stdio.h>', '#include <stdlib.h>', '#include <string.h>', ''])
        else
            call extend(l:lines, ['#include <iostream>', '#include <cstdio>', '#include <cstdlib>',
                        \ '#include <queue>', '#include <stack>', '#include <algorithm>',
                        \ '#include <string>', '#include <map>', '#include <set>', '#include <vector>',
                        \ 'using namespace std;', ''])
        endif
    endif
    call setline(1, l:lines)
    call cursor(len(l:lines), 1)
endfunction

" :make on Python checks syntax. It does not execute the edited program.
" Resolve an interpreter only when explicitly running :make, so a newly created
" .venv also works. shellescape(..., 1) protects shell and Vim special characters.
function! s:PythonMake() abort
    let l:directory = expand('%:p:h')
    let l:python = ''
    while !empty(l:directory)
        let l:candidate = l:directory . '/.venv/bin/python'
        if executable(l:candidate)
            let l:python = l:candidate
            break
        endif
        let l:parent = fnamemodify(l:directory, ':h')
        if l:parent ==# l:directory
            break
        endif
        let l:directory = l:parent
    endwhile
    if empty(l:python) && !empty($VIRTUAL_ENV) && executable($VIRTUAL_ENV . '/bin/python')
        let l:python = $VIRTUAL_ENV . '/bin/python'
    endif
    if empty(l:python)
        let l:python = exepath('python3')
    endif
    if empty(l:python)
        let l:python = 'python3'
    endif
    let &l:makeprg = shellescape(l:python, 1) . ' -m py_compile %:S'
    let &l:errorformat = '%A  File "%f"\, line %l%.%#,%C    %.%#,%Z%m'
endfunction

augroup linux_env
    autocmd!
    autocmd BufNewFile *.c,*.cpp,*.cc,*.cxx,*.py call <SID>NewSourceHeader()
    " Keep // comments on their own line, without disabling /* */ continuation.
    autocmd FileType c,cpp setlocal comments-=:/// comments-=:// comments+=f:/// comments+=f://
    autocmd FileType c,cpp setlocal suffixesadd=.h,.hpp,.hh,.hxx
    autocmd FileType c,cpp setlocal makeprg=cmake\ --build\ build
    autocmd FileType python call <SID>PythonMake()
    autocmd QuickFixCmdPre make if &filetype ==# 'python' | call <SID>PythonMake() | endif
    autocmd FileType sh,yaml,json setlocal shiftwidth=2 softtabstop=2
    autocmd FileType make setlocal noexpandtab
augroup END

